{
  "rules": {
    "single-export-per-file": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "module.ts",
        "*-module.ts",
        "static.ts",
        "*.schemas.ts",
        "utils.ts",
        "setup.ts",
        "selectors.ts",
        "actions.ts"
      ]
    },
    "filename-convention": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "index.mts",
        "index.cts",
        "*.d.ts",
        "module.ts",
        "configurator.ts",
        "provider.ts",
        "client.ts",
        "client-msal.ts",
        "route-factory.ts",
        "static.ts",
        "types.ts",
        "enable-signalr.ts",
        "main.ts",
        "main.tsx",
        "plugin.ts",
        "build.ts",
        "check.ts",
        "config.ts",
        "dev.ts",
        "manifest.ts",
        "pack.ts",
        "publish.ts",
        "serve.ts",
        "tag.ts",
        "upload.ts",
        "login.ts",
        "logout.ts",
        "token.ts",
        "schema.ts"
      ]
    }
  },
  "ignorePatterns": ["**/__tests__/**"]
}
