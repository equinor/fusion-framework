{
  "rules": {
    "single-export-per-file": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "module.ts",
        "*-module.ts",
        "static.ts",
        "*.schemas.ts"
      ]
    },
    "filename-convention": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "index.mts",
        "index.cts",
        "*.d.ts",
        "module.ts",
        "configurator.ts",
        "provider.ts",
        "client.ts",
        "client-msal.ts",
        "route-factory.ts",
        "static.ts",
        "types.ts",
        "enable-signalr.ts"
      ]
    }
  },
  "ignorePatterns": ["**/__tests__/**"]
}
