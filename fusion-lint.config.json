{
  "rules": {
    "single-export-per-file": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "module.ts",
        "*-module.ts",
        "static.ts",
        "*.schemas.ts",
        "utils.ts",
        "setup.ts",
        "selectors.ts",
        "actions.ts",
        "options.ts",
        "predicates.ts",
        "helpers.ts"
      ]
    },
    "filename-convention": {
      "excludePattern": [
        "index.ts",
        "index.tsx",
        "index.mts",
        "index.cts",
        "*.d.ts",
        "module.ts",
        "configurator.ts",
        "provider.ts",
        "client.ts",
        "client-msal.ts",
        "route-factory.ts",
        "static.ts",
        "types.ts",
        "enable-signalr.ts",
        "main.ts",
        "main.tsx",
        "plugin.ts",
        "*.command.ts"
      ]
    }
  },
  "ignorePatterns": ["**/__tests__/**"]
}
