{
  "name": "Fusion Framework developer",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.1.2-24-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "11.22.0",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {
      "version": "1.0.80"
    }
  },
  "updateContentCommand": "pnpm install --frozen-lockfile --prefer-offline && pnpm build:packages",
  "waitFor": "updateContentCommand"
}
