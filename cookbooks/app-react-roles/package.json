{
  "name": "@equinor/fusion-framework-cookbook-app-react-roles",
  "version": "0.0.0",
  "description": "Cookbook for displaying, checking, and claiming Fusion Roles V2 access",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "fusion-framework-cli app build",
    "dev": "fusion-framework-cli app dev",
    "dev:mock": "concurrently -k \"pnpm mock:server\" \"pnpm mock:app\"",
    "mock:app": "fusion-framework-cli app dev --mock http://localhost:4012",
    "mock:server": "fusion-framework-cli mock-server --preset=fusion ./mocks --port 4012 --seed 42",
    "test": "playwright test"
  },
  "devDependencies": {
    "@equinor/fusion-framework-cli": "workspace:^",
    "@equinor/fusion-framework-cli-plugin-mock-server": "workspace:^",
    "@equinor/fusion-framework-module-roles": "workspace:^",
    "@equinor/fusion-framework-react-app": "workspace:^",
    "@equinor/fusion-framework-react-components-roles": "workspace:^",
    "@equinor/fusion-openapi-mock-server": "workspace:^",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "styled-components": "^6.3.11",
    "typescript": "^7.0.2"
  }
}
