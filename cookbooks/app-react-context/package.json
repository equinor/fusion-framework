{
  "name": "@equinor/fusion-framework-cookbook-app-react-context",
  "version": "5.0.9",
  "description": "React application using framework context",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "pre-build": "tsc -b",
    "build": "fusion-framework-cli app build",
    "dev": "fusion-framework-cli app dev",
    "dev:mock": "concurrently -k 'pnpm mock:server' 'pnpm mock:dev'",
    "mock:dev": "ffc app dev --mock http://localhost:4011",
    "mock:server": "ffc mock-server --preset=fusion ./mocks --port 4011 --seed 42",
    "test": "vitest --run",
    "test:playwright": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@equinor/fusion-framework-cli": "workspace:^",
    "@equinor/fusion-framework-module-navigation": "workspace:^",
    "@equinor/fusion-framework-react-app": "workspace:^",
    "@equinor/fusion-framework-react-module-context": "workspace:^",
    "@equinor/fusion-observable": "workspace:^",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@equinor/fusion-framework": "workspace:^",
    "@equinor/fusion-framework-app": "workspace:^",
    "@equinor/fusion-framework-cli-plugin-mock-server": "workspace:^",
    "@equinor/fusion-framework-module-app": "workspace:^",
    "@equinor/fusion-framework-module-context": "workspace:^",
    "@equinor/fusion-framework-vitest-plugin-react-app": "workspace:^",
    "@equinor/fusion-openapi-mock-server": "workspace:^",
    "@playwright/test": "^1.62.1",
    "@vitest/browser-playwright": "^4.1.0",
    "concurrently": "^10.0.5",
    "odata-query": "^8.0.4",
    "playwright": "^1.62.1",
    "rxjs": "^7.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
