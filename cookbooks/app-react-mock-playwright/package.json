{
  "name": "@equinor/fusion-framework-cookbook-app-react-mock-playwright",
  "version": "0.0.7",
  "description": "Cookbook for testing a Fusion Framework app with Playwright and ffc mock-server",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "ffc app build",
    "dev": "ffc app dev",
    "dev:mock": "concurrently -k 'pnpm mock:server' 'pnpm mock:dev'",
    "mock:dev": "ffc app dev --mock http://localhost:4010",
    "mock:server": "ffc mock-server ./mocks --port 4010 --analytics-seed mocks/analytics.seed.jsonl",
    "test": "pnpm test:playwright",
    "test:playwright": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@equinor/eds-core-react": "^2.6.2",
    "@equinor/eds-icons": "^1.5.1",
    "@equinor/fusion-framework-cli": "workspace:^",
    "@equinor/fusion-framework-cli-plugin-mock-server": "workspace:^",
    "@equinor/fusion-framework-module-navigation": "workspace:^",
    "@equinor/fusion-framework-react-app": "workspace:^",
    "@equinor/fusion-framework-react-router": "workspace:^",
    "@equinor/fusion-openapi-mock-server": "workspace:^",
    "@equinor/fusion-services": "workspace:^",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "concurrently": "^10.0.5",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2"
  }
}
