{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": true,
  "globalPassThroughEnv": [
    "GITHUB_ACTIONS",
    "GITHUB_API_URL",
    "GITHUB_EVENT_PATH",
    "GITHUB_OUTPUT",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VUEPRESS_BASE"],
      "outputs": ["dist/**", "bin/build/**"],
      "cache": true
    },
    "test:playwright": {
      "dependsOn": ["^build", "@equinor/fusion-framework-cli-plugin-ai-index#build"],
      "cache": false
    },
    "//#preindex:eds": {
      "inputs": ["eds/Dockerfile", "eds/*.ts"],
      "outputs": ["eds/out/**"],
      "cache": true
    },
    "//#index:eds": {
      "dependsOn": ["@equinor/fusion-framework-cli#build", "//#preindex:eds"],
      "cache": false
    },
    "//#index:packages": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false
    },
    "//#index:cookbooks": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false
    },
    "//#index:docs:create": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:clean": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:full": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:diff": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV", "BASE_REF"]
    }
  }
}
