{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["GITHUB_ACTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VUEPRESS_BASE"],
      "outputs": ["dist/**", "bin/build/**"],
      "cache": true
    },
    "test:playwright": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#preindex:eds": {
      "inputs": ["eds/Dockerfile", "eds/*.ts"],
      "outputs": ["eds/out/**"],
      "cache": true
    },
    "//#index:eds": {
      "dependsOn": ["@equinor/fusion-framework-cli#build", "//#preindex:eds"],
      "cache": false
    },
    "//#index:packages": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false
    },
    "//#index:cookbooks": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false
    },
    "//#index:docs:create": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:clean": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:full": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV"]
    },
    "//#index:docs:diff": {
      "dependsOn": ["@equinor/fusion-framework-cli#build"],
      "cache": false,
      "passThroughEnv": ["FUSION_ENV", "BASE_REF"]
    }
  }
}
