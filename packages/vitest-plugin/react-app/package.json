{
  "name": "@equinor/fusion-framework-vitest-plugin-react-app",
  "version": "0.2.0-next.3",
  "description": "Vite plugin resolving an application's manifest, config, and module-configurator as virtual modules for testing.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./test": {
      "types": "./dist/types/app-test.d.ts",
      "import": "./dist/esm/app-test.js"
    },
    "./config": {
      "types": "./dist/types/define-project.d.ts",
      "import": "./dist/esm/define-project.js"
    }
  },
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "test": [
        "dist/types/app-test.d.ts"
      ],
      "config": [
        "dist/types/define-project.d.ts"
      ]
    }
  },
  "directories": {
    "dist": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/fusion-framework.git",
    "directory": "packages/vitest-plugin/react-app"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest --run",
    "prepack": "pnpm build"
  },
  "keywords": [
    "vite",
    "vitest",
    "fusion-framework",
    "testing"
  ],
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@equinor/fusion-framework": "workspace:*",
    "@equinor/fusion-framework-app": "workspace:*",
    "@equinor/fusion-framework-cli": "workspace:*",
    "@equinor/fusion-framework-module": "workspace:*",
    "@equinor/fusion-framework-module-app": "workspace:*",
    "@equinor/fusion-framework-module-navigation": "workspace:*",
    "@equinor/fusion-framework-react": "workspace:*",
    "@equinor/fusion-framework-react-module": "workspace:*",
    "@equinor/fusion-imports": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.0",
    "playwright": "^1.62.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rxjs": "^7.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "rxjs": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vitest-browser-react": "^2.2.0"
  }
}
