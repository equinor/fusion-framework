{
  "name": "@equinor/fusion-openapi-mock-server",
  "version": "0.1.0",
  "description": "Standalone HTTP server that serves @equinor/fusion-openapi-mock fakes from a directory of OpenAPI specs, addressable directly by tests (e.g. Playwright) as well as local dev",
  "keywords": [
    "openapi",
    "mock",
    "server",
    "testing",
    "typescript",
    "equinor",
    "fusion"
  ],
  "license": "ISC",
  "type": "module",
  "main": "dist/esm/index.js",
  "bin": {
    "fusion-mock": "dist/esm/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./server": {
      "import": "./dist/esm/server/index.js",
      "types": "./dist/types/server/index.d.ts"
    },
    "./discovery": {
      "import": "./dist/esm/discovery/index.js",
      "types": "./dist/types/discovery/index.d.ts"
    },
    "./presets": {
      "import": "./dist/esm/presets/index.js",
      "types": "./dist/types/presets/index.d.ts"
    },
    "./presets/fusion": {
      "import": "./dist/esm/presets/fusion/index.js",
      "types": "./dist/types/presets/fusion/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/types/index.d.ts"
      ],
      "server": [
        "dist/types/server/index.d.ts"
      ],
      "discovery": [
        "dist/types/discovery/index.d.ts"
      ],
      "presets": [
        "dist/types/presets/index.d.ts"
      ],
      "presets/fusion": [
        "dist/types/presets/fusion/index.d.ts"
      ]
    }
  },
  "types": "dist/types/index.d.ts",
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/fusion-framework.git",
    "directory": "packages/utils/openapi-mock-server"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "bugs": {
    "url": "https://github.com/equinor/fusion-framework/issues"
  },
  "dependencies": {
    "@equinor/fusion-imports": "workspace:^",
    "@equinor/fusion-openapi-mock": "workspace:^",
    "@faker-js/faker": "^10.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
