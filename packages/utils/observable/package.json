    "@vitest/browser-playwright": "^4.1.0",
    "playwright": "^1.62.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
