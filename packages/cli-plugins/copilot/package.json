{
  "name": "@equinor/fusion-framework-cli-plugin-copilot",
  "version": "2.0.4",
  "description": "Copilot SDK powered evaluation plugin for Fusion Framework CLI",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:types": "tsc -b",
    "prepack": "pnpm rebuild agent-browser koffi && pnpm build"
  },
  "keywords": [
    "fusion-framework",
    "cli",
    "plugin",
    "copilot",
    "copilot-sdk",
    "agent-browser"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/fusion-framework.git",
    "directory": "packages/cli-plugins/copilot"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.0",
    "agent-browser": "^0.34.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.3.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@equinor/fusion-framework-cli": "^15.2.9"
  },
  "devDependencies": {
    "@equinor/fusion-framework-cli": "^15.2.9",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "vscode-jsonrpc@8.2.1": "patches/vscode-jsonrpc@8.2.1.patch"
    },
    "neverBuiltDependencies": [
      "agent-browser",
      "koffi"
    ]
  }
}
