{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!turbo",
      "!**/vue-press/src/.vuepress",
      "!package.json",
      "!pnpm-lock.yaml",
      "!**/openapi-mock-server/src/__tests__/fixtures/broken",
      "!**/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "useEditorconfig": true,
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "fix": "safe",
          "options": {
            "forceJsExtensions": true
          }
        }
      }
    },
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist/**",
      "!**/*.config.js",
      "!**/version.ts",
      "!**/vue-press/src/.vuepress",
      "!**/*.drawio.svg"
    ]
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "bracketSameLine": false,
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/packages/react/**"]
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/__mocks__/**",
        "**/tests/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.stories.tsx",
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/scripts/**",
        "**/bin/**",
        "**/dev-server.ts",
        "**/cookbooks/**",
        "**/eds/**",
        "**/vue-press/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    }
  ]
}
